# application-secret.properties 템플릿.
# 이 파일을 복사해서 같은 폴더에 application-secret.properties로 저장하고 실제 값을 채워 넣으세요.
# application-secret.properties는 .gitignore에 있어서 git에 올라가지 않으므로, 새 키가 추가될 때마다
# 이 예시 파일도 같이 업데이트해서 팀원들이 뭘 채워야 하는지 알 수 있게 해주세요.

jwt.secret=아무 256bit 랜덤 문자열 (예: openssl rand -base64 32)

# 카카오 개발자 콘솔(https://developers.kakao.com) > 내 애플리케이션 > 앱 키에서 확인
spring.security.oauth2.client.registration.kakao.client-id=
spring.security.oauth2.client.registration.kakao.client-secret=

# 회원가입/비밀번호 재설정 인증코드 발송용 Gmail 계정.
# 구글 계정 2단계 인증을 켠 뒤, 앱 비밀번호(https://myaccount.google.com/apppasswords)를 발급받아 사용.
# 개인 Gmail을 써도 되고, 팀에서 공용으로 만든 계정이 있다면 그 계정/앱 비밀번호를 공유받아 써도 됨.
spring.mail.username=본인(또는 팀 공용) Gmail 주소
spring.mail.password=위 계정의 앱 비밀번호 (공백 없이 16자)

spring.datasource.password=로컬 MySQL 비밀번호

# (선택) 로컬 대신 팀 공용 RDS에 연결하고 싶다면 아래 세 줄의 주석을 풀고 실제 값을 채우면 됨.
# 안 채우면 application.properties에 정의된 localhost MySQL로 연결됨. 실제 접속 정보는 팀 채널에서 확인.
# spring.datasource.url=jdbc:mysql://<rds-host>:3306/fridge?serverTimezone=Asia/Seoul&characterEncoding=UTF-8&useUnicode=true
# spring.datasource.username=<rds-username>
# spring.datasource.password=<rds-password>

# (선택) 식약처 레시피 수집 배치(RecipeImportService)를 실제로 돌리고 싶다면 채우면 됨.
# 안 채워도 앱 실행 자체엔 지장 없음 (application.properties에서 빈 값으로 기본 처리).
# foodsafety.api.key=<공공데이터포털에서 발급받은 인증키>

# (선택) 커뮤니티 게시글 이미지/동영상을 공용 저장소(S3)에 올리고 싶다면 채우면 됨.
# 안 채우면 로컬 디스크(uploads/community)에 저장되는데, 이 경우 본인 컴퓨터에서만 이미지가 보임
# (DB는 RDS로 공용이라 다른 사람 화면엔 깨져 보임 — 실제 버킷/키는 팀 채널에서 확인).
# aws.s3.bucket=<bucket-name>
# aws.s3.region=ap-northeast-2
# aws.s3.access-key=<iam-access-key>
# aws.s3.secret-key=<iam-secret-key>
